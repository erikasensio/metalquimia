# URL del WordPress (LocalWP en local)
WP_URL=http://metalquimia.local
# Idiomas activos en Polylang (códigos, el primero es el idioma por defecto y va sin prefijo en la URL)
NEXT_PUBLIC_LOCALES=en,es,ca,de
# Secreto compartido con el plugin metalquimia-core (constante MQ_REVALIDATE_SECRET en wp-config.php)
REVALIDATE_SECRET=cambia-esto
# Solo si el WordPress está protegido con contraseña (p. ej. Live Link de LocalWP): usuario:contraseña
WP_AUTH=
