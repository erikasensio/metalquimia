{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metalquimia",
  // Cuenta de Demà (Lluis@dema.studio), dueña de la zona dema.studio
  "account_id": "ae76aa952534da77650b546cc8933f2e",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Autorreferencia que usa OpenNext para la caché; debe coincidir con "name"
    { "binding": "WORKER_SELF_REFERENCE", "service": "metalquimia" }
  ],
  "kv_namespaces": [
    // Caché de páginas y fetch de WordPress
    { "binding": "NEXT_INC_CACHE_KV", "id": "2bdfde843b064a3bba1f8311f8239540" },
    // Etiquetas que invalida /api/revalidate
    { "binding": "NEXT_TAG_CACHE_KV", "id": "1b9a232c6bae4a109e7ab77195416dab" },
    // Copia de /wp-content/uploads mientras WordPress va por Live Link (ver route.ts de uploads)
    { "binding": "MEDIA_KV", "id": "51b745cbab9f4921906efafe6e29eb4e" }
  ],
  // Optimización de next/image con Cloudflare Images
  "images": { "binding": "IMAGES" },
  // Valores no secretos; REVALIDATE_SECRET va con `wrangler secret put`
  "vars": {
    "NEXT_PUBLIC_LOCALES": "en,es,ca,de"
  },
  "routes": [{ "pattern": "metalquimia.dema.studio", "custom_domain": true }],
  "observability": { "enabled": true }
}
